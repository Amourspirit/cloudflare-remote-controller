COMPOSE_PROJECT_NAME=cfroute-controller
CF_API_TOKEN=<Cloudflare API Token with DNS Edit>
CF_ZONE_ID=<Default Zone ID>
CF_MANAGED_ZONE_IDS=
CF_TUNNEL_CNAME=<tunnel-id>.cfargotunnel.com
RECONCILE_INTERVAL_SECONDS=120
EVENT_DEBOUNCE_MS=500
ALLOW_TARGET_MISMATCH=false
LOG_LEVEL=info
CLOUDFLARE_TIMEOUT_SECONDS=20
CLOUDFLARE_MAX_ATTEMPTS=3

DOCKER_SOCKET_PATH=/var/run/docker.sock